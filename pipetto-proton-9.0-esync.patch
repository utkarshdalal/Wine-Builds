From 58abee2506ef17d802ea1e8a43c4b8d640008b8b Mon Sep 17 00:00:00 2001
From: Utkarsh Dalal <utkarsh.dalal@toptal.com>
Date: Sun, 5 Oct 2025 17:07:52 +0530
Subject: [PATCH 1/3] pipetto-proton-9.0-esync

---
 dlls/ntdll/unix/esync.c     | 23 ++++++++++++++++++-----
 programs/winebrowser/main.c |  4 ++--
 server/esync.c              | 31 ++++++++++++++++++++++---------
 server/unicode.c            |  2 +-
 4 files changed, 43 insertions(+), 17 deletions(-)

diff --git a/dlls/ntdll/unix/esync.c b/dlls/ntdll/unix/esync.c
index 7b541d6f3eb..9a1fce14cd3 100644
--- a/dlls/ntdll/unix/esync.c
+++ b/dlls/ntdll/unix/esync.c
@@ -110,7 +110,8 @@ struct event
 };
 C_ASSERT(sizeof(struct event) == 8);
 
-static char shm_name[29];
+static char shm_name[200];
+static int termux_esync;
 static int shm_fd;
 static void **shm_addrs;
 static int shm_addrs_size;  /* length of the allocated shm_addrs array */
@@ -1345,12 +1346,24 @@ void esync_init(void)
     if (stat( config_dir, &st ) == -1)
         ERR("Cannot stat %s\n", config_dir);
 
-    if (st.st_ino != (unsigned long)st.st_ino)
-        sprintf( shm_name, "/wine-%lx%08lx-esync", (unsigned long)((unsigned long long)st.st_ino >> 32), (unsigned long)st.st_ino );
+    termux_esync = getenv("WINEESYNC_WINLATOR") && atoi(getenv("WINEESYNC_WINLATOR"));
+
+    if (termux_esync)
+    {
+        if (st.st_ino != (unsigned long)st.st_ino)
+            sprintf( shm_name, "/data/data/app.gamenative/files/imagefs/usr/tmp/wine-%lx%08lx-esync", (unsigned long)((unsigned long long)st.st_ino >> 32), (unsigned long)st.st_ino );
+        else
+            sprintf( shm_name, "/data/data/app.gamenative/files/imagefs/usr/tmp/wine-%lx-esync", (unsigned long)st.st_ino );
+    }
     else
-        sprintf( shm_name, "/wine-%lx-esync", (unsigned long)st.st_ino );
+    {
+        if (st.st_ino != (unsigned long)st.st_ino)
+            sprintf( shm_name, "/wine-%lx%08lx-esync", (unsigned long)((unsigned long long)st.st_ino >> 32), (unsigned long)st.st_ino );
+        else
+            sprintf( shm_name, "/wine-%lx-esync", (unsigned long)st.st_ino );
+    }
 
-    if ((shm_fd = shm_open( shm_name, O_RDWR, 0644 )) == -1)
+    if ((termux_esync && (shm_fd = open( shm_name, O_RDWR, 0644 )) == -1) || (!termux_esync && (shm_fd = shm_open( shm_name, O_RDWR, 0644 )) == -1))
     {
         /* probably the server isn't running with WINEESYNC, tell the user and bail */
         if (errno == ENOENT)
diff --git a/programs/winebrowser/main.c b/programs/winebrowser/main.c
index b2083a162a5..1938e52d0d0 100644
--- a/programs/winebrowser/main.c
+++ b/programs/winebrowser/main.c
@@ -228,7 +228,7 @@ static int open_http_url( const WCHAR *url )
 {
     static const WCHAR defaultbrowsers[] =
         L"xdg-open\0"
-        "/usr/bin/open\0"
+        "/data/data/app.gamenative/files/imagefs/usr/bin/open\0"
         "firefox\0"
         "konqueror\0"
         "mozilla\0"
@@ -274,7 +274,7 @@ static int open_http_url( const WCHAR *url )
 static int open_mailto_url( const WCHAR *url )
 {
     static const WCHAR defaultmailers[] =
-        L"/usr/bin/open\0"
+        L"/data/data/app.gamenative/files/imagefs/usr/bin/open\0"
         "xdg-email\0"
         "mozilla-thunderbird\0"
         "thunderbird\0"
diff --git a/server/esync.c b/server/esync.c
index 9549a9c6c9b..645827d31da 100644
--- a/server/esync.c
+++ b/server/esync.c
@@ -84,17 +84,18 @@ int do_esync(void)
 #endif
 }
 
-static char shm_name[29];
+static char shm_name[200];
 static int shm_fd;
 static off_t shm_size;
 static void **shm_addrs;
 static int shm_addrs_size;  /* length of the allocated shm_addrs array */
 static long pagesize;
+static int termux_esync;
 
 static void shm_cleanup(void)
 {
     close( shm_fd );
-    if (shm_unlink( shm_name ) == -1)
+    if ((termux_esync && unlink( shm_name ) == -1) || (!termux_esync && shm_unlink( shm_name ) == -1))
         perror( "shm_unlink" );
 }
 
@@ -105,14 +106,26 @@ void esync_init(void)
     if (fstat( config_dir_fd, &st ) == -1)
         fatal_error( "cannot stat config dir\n" );
 
-    if (st.st_ino != (unsigned long)st.st_ino)
-        sprintf( shm_name, "/wine-%lx%08lx-esync", (unsigned long)((unsigned long long)st.st_ino >> 32), (unsigned long)st.st_ino );
-    else
-        sprintf( shm_name, "/wine-%lx-esync", (unsigned long)st.st_ino );
-
-    shm_unlink( shm_name );
+    termux_esync = getenv("WINEESYNC_WINLATOR") && atoi(getenv("WINEESYNC_WINLATOR"));
 
-    shm_fd = shm_open( shm_name, O_RDWR | O_CREAT | O_EXCL, 0644 );
+    if (termux_esync)
+    {
+        if (st.st_ino != (unsigned long)st.st_ino)
+            sprintf( shm_name, "/data/data/app.gamenative/files/imagefs/usr/tmp/wine-%lx%08lx-esync", (unsigned long)((unsigned long long)st.st_ino >> 32), (unsigned long)st.st_ino );
+        else
+            sprintf( shm_name, "/data/data/app.gamenative/files/imagefs/usr/tmp/wine-%lx-esync", (unsigned long)st.st_ino );
+        unlink( shm_name );
+        shm_fd = open( shm_name, O_RDWR | O_CREAT | O_EXCL, 0644 );
+    }
+    else
+    {
+        if (st.st_ino != (unsigned long)st.st_ino)
+            sprintf( shm_name, "/wine-%lx%08lx-esync", (unsigned long)((unsigned long long)st.st_ino >> 32), (unsigned long)st.st_ino );
+        else
+            sprintf( shm_name, "/wine-%lx-esync", (unsigned long)st.st_ino );
+        shm_unlink( shm_name );
+        shm_fd = shm_open( shm_name, O_RDWR | O_CREAT | O_EXCL, 0644 );
+    }
     if (shm_fd == -1)
         perror( "shm_open" );
 
diff --git a/server/unicode.c b/server/unicode.c
index 3294512d84e..0ae6ed9ed7b 100644
--- a/server/unicode.c
+++ b/server/unicode.c
@@ -277,7 +277,7 @@ static char *get_nls_dir(void)
 /* load the case mapping table */
 struct fd *load_intl_file(void)
 {
-    static const char *nls_dirs[] = { NULL, NLSDIR, "/wine/nls", "/usr/local/share/wine/nls", "/usr/share/wine/nls" };
+    static const char *nls_dirs[] = { NULL, NLSDIR, "/data/data/app.gamenative/files/imagefs/usr/local/share/wine/nls", "/data/data/app.gamenative/files/imagefs/usr/share/wine/nls" };
     static const WCHAR nt_pathW[] = {'C',':','\\','w','i','n','d','o','w','s','\\',
         's','y','s','t','e','m','3','2','\\','l','_','i','n','t','l','.','n','l','s',0};
     static const struct unicode_str nt_name = { nt_pathW, sizeof(nt_pathW) };
-- 
