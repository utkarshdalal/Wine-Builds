Subject: [PATCH 3/3] pipetto-proton-9.0-wine-virtual-memory

---
 server/mapping.c | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/server/mapping.c b/server/mapping.c
index 0702f156cf8..7d065ee393f 100644
--- a/server/mapping.c
+++ b/server/mapping.c
@@ -245,11 +245,7 @@ void init_memory(void)
 {
     page_mask = sysconf( _SC_PAGESIZE ) - 1;
     free_map_addr( 0x60000000, 0x1c000000 );
-#ifdef __aarch64__
     free_map_addr( 0x4000000000, 0x1000000000 );
-#else
-    free_map_addr( 0x600000000000, 0x100000000000 );
-#endif
 }
 
 static void ranges_dump( struct object *obj, int verbose )
